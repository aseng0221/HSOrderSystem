require 'fileutils'
# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '16.0'
prepare_react_native_project!

  # Fix for Firebase Swift modularity requirements
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseAuthInterop', :modular_headers => true
  pod 'FirebaseAppCheckInterop', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true
  pod 'FirebaseFirestoreInternal', :modular_headers => true

# God Plan v10: Absolute Consolidation Mode
$RNFirebaseAsStaticFramework = true

flipper_config = FlipperConfiguration.disabled

target 'HSOrderSystem' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :flipper_configuration => flipper_config,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )
  
  target 'HSOrderSystemTests' do
    inherit! :complete
  end

  post_install do |installer|
    # CONSOLIDATED POST-INSTALL: Stabilizing Xcode 16.4 Build Environment
    
    installer.pods_project.targets.each do |target|
      # 1. Target Build Configuration settings
      target.build_configurations.each do |build_config|
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
        
        # Performance and compatibility fixes for Xcode 16+
        build_config.build_settings['CLANG_USE_RESPONSE_FILE'] = 'NO'
        build_config.build_settings['SWIFT_USE_RESPONSE_FILES'] = 'NO'
        build_config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
        build_config.build_settings['COMPILER_INDEX_STORE_ENABLE'] = 'NO'
        build_config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
        build_config.build_settings['USE_HEADERMAP'] = 'YES'
        build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'gnu++17'
        build_config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
        build_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'

        # MODULARITY MANAGEMENT: Surgical isolation to prevent namespace shadowing
        firebase_google_pods = ['Firebase', 'Google', 'RNFB', 'RecaptchaInterop', 'PromisesObjC', 'nanopb', 'FirebaseAuth', 'FirebaseFirestore']
        non_modular_pods = [
          'glog', 'Yoga', 'fmt', 'DoubleConversion', 
          'gRPC-Core', 'gRPC-C++', 'BoringSSL-GRPC', 
          'RCT-Folly', 'React-graphics', 'React-Fabric', 'React-Codegen', 'rsocket',
          'React-Core', 'React-utils', 'React-debug', 'React-runtimescheduler', 'leveldb', 'leveldb-library'
        ]
        
        target_name = target.respond_to?(:product_name) ? (target.product_name || target.name) : target.name
        safe_target_name = target.name || ""
        safe_target_product_name = target_name || ""
        is_firebase_google = firebase_google_pods.any? { |p| safe_target_name.start_with?(p) || safe_target_product_name.start_with?(p) }
        is_abseil = safe_target_name.start_with?('abseil')
        
        if non_modular_pods.include?(target.name) || is_abseil
          build_config.build_settings['DEFINES_MODULE'] = 'NO'
          build_config.build_settings['CLANG_ENABLE_MODULES'] = 'NO'
          # React-Core needs headermaps for its own internal structure even if non-modular
          build_config.build_settings['USE_HEADERMAP'] = 'NO' if target.name != 'React-Core'
        elsif is_firebase_google
          build_config.build_settings['DEFINES_MODULE'] = 'YES'
          build_config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
        end

        # REFINEMENT: Custom Search Paths for C++ and Swift bridging
        if safe_target_name.start_with?('RNFB')
          build_config.build_settings['HEADER_SEARCH_PATHS'] ||= '$(inherited)'
          build_config.build_settings['HEADER_SEARCH_PATHS'] << ' "$(PODS_CONFIGURATION_BUILD_DIR)/FirebaseAuth" "$(PODS_ROOT)/Headers/Public/FirebaseAuth" "$(DERIVED_SOURCES_DIR)"'
        end
        if target.name == 'gRPC-Core'
          build_config.build_settings['HEADER_SEARCH_PATHS'] ||= '$(inherited)'
          build_config.build_settings['HEADER_SEARCH_PATHS'] << ' "$(SDKROOT)/usr/include"'
          build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
          build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'HAVE_FDOPEN=1'
        end
        if target.name == 'Yoga'
          build_config.build_settings['HEADER_SEARCH_PATHS'] ||= '$(inherited)'
          build_config.build_settings['HEADER_SEARCH_PATHS'] << ' "$(PODS_ROOT)/Yoga" "$(PODS_ROOT)/Yoga/yoga"'
        end
        if target.name == 'glog'
          build_config.build_settings['HEADER_SEARCH_PATHS'] ||= '$(inherited)'
          build_config.build_settings['HEADER_SEARCH_PATHS'] << ' "$(PODS_ROOT)/glog/src"'
        end
      end

      # Expose FirebaseAuth swift bridging header for React Native Firebase targets
      if target.name == 'FirebaseAuth'
        unless target.shell_script_build_phases.any? { |p| p.name == 'Export Swift Header to Public' }
          phase = target.new_shell_script_build_phase('Export Swift Header to Public')
          phase.shell_script = "mkdir -p \"${PODS_ROOT}/Headers/Public/FirebaseAuth\"\ncp \"${DERIVED_SOURCES_DIR}/FirebaseAuth-Swift.h\" \"${PODS_ROOT}/Headers/Public/FirebaseAuth/FirebaseAuth-Swift.h\" 2>/dev/null || true"
        end
      end

      # 2. Build Phase Script Injections for automated patching
      
      # Fix 'Multiple commands produce' error for glog headers
      if target.name == 'glog'
        target.build_phases.each do |phase|
          if phase.respond_to?(:display_name) && phase.display_name == 'Headers'
            phase.files.delete_if do |f|
              path = f.file_ref.path
              path.start_with?('src/') && !path.start_with?('src/glog/') && path.end_with?('.h')
            end
          end
        end
      end

      # gRPC Module Map path stabilization
      if target.name == 'gRPC-C++'
        phase_name = 'Stabilize gRPC Module Maps'
        target.build_phases.delete_if { |p| p.respond_to?(:name) && p.name == phase_name }
        phase = target.new_shell_script_build_phase(phase_name)
        phase.shell_script = "mkdir -p \"${PODS_ROOT}/Headers/Private/grpc\" && cp \"${PODS_ROOT}/Target Support Files/gRPC-Core/gRPC-Core.modulemap\" \"${PODS_ROOT}/Headers/Private/grpc/gRPC-Core.modulemap\""
        phase.show_env_vars_in_log = '0'
        target.build_phases.insert(0, target.build_phases.delete_at(target.build_phases.length - 1))
      end

      # gRPC-Core zutil.h macro conflict patch
      if target.name == 'gRPC-Core'
        phase_name = 'Patch gRPC zutil.h'
        target.build_phases.delete_if { |p| p.respond_to?(:name) && p.name == phase_name }
        phase = target.new_shell_script_build_phase(phase_name)
        # Use robust sed with character classes for spaces
        phase.shell_script = "sed -i '' 's/#[[:space:]]*define[[:space:]]*fdopen(fd,mode)[[:space:]]*NULL/\\/\\/#define fdopen patched/g' \"${PODS_ROOT}/gRPC-Core/third_party/zlib/zutil.h\""
        phase.show_env_vars_in_log = '0'
        target.build_phases.insert(0, target.build_phases.delete_at(target.build_phases.length - 1))
      end
    end

    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # 3. Project-level stabilization for aggregate targets
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_project.targets.each do |project_target|
        project_target.build_configurations.each do |config|
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'gnu++17'
          config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
          config.build_settings['COMPILER_INDEX_STORE_ENABLE'] = 'NO'
          config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
          config.build_settings['USE_HEADERMAP'] = 'YES'
          
          config.build_settings.delete('DEVELOPMENT_TEAM')
          config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
          config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
          config.build_settings['CODE_SIGN_IDENTITY'] = ''
          config.build_settings['CODE_SIGN_STYLE'] = 'Manual'
        end
      end
      aggregate_target.user_project.save
    end
  end

  post_integrate do |installer|
    # Strip invalid weak_framework flag added by Firebase pods
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.xcconfigs.each do |config_name, config_file|
        path = aggregate_target.xcconfig_path(config_name)
        if File.exist?(path)
          content = File.read(path)
          if content.include?('-weak_framework "FirebaseFirestoreInternal"')
            content.gsub!('-weak_framework "FirebaseFirestoreInternal"', '')
            File.open(path, 'w') { |f| f.write(content) }
          end
        end
      end
    end
  end
end
