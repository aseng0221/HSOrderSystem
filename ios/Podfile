require 'fileutils'

# Ruby 3.4 Compatibility Shim
begin
  require 'kconv'
rescue LoadError
  module Kconv
    AUTO = nil; JIS = nil; EUC = nil; SJIS = nil; BINARY = nil; NOCONV = nil; ASCII = nil; UTF8 = nil; UTF16 = nil; UTF32 = nil
    def self.kconv(str, out_code, in_code = nil); str; end
    def self.tosjis(str); str; end
    def self.toeuc(str); str; end
    def self.tojis(str); str; end
    def self.toutf8(str); str; end
    def self.toutf16(str); str; end
    def self.toutf32(str); str; end
  end
  $LOADED_FEATURES << 'kconv.rb'
  $LOADED_FEATURES << 'kconv'
end

require_relative '../node_modules/react-native/scripts/react_native_pods'
require_relative '../node_modules/@react-native-community/cli-platform-ios/native_modules'

platform :ios, '16.0'
prepare_react_native_project!

# Global Static Linkage for Firebase Compatibility
use_frameworks! :linkage => :static

target 'HSOrderSystem' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :fabric_enabled => true,
    :hermes_enabled => true
  )

  target 'HSOrderSystemTests' do
    inherit! :complete
  end

  post_install do |installer|
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # ABI Stability: Force C++20 for Abseil/gRPC
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
        
        # Code Signing Fix for Bundles
        if target.respond_to?(:product_type) && target.product_type == "com.apple.product-type.bundle"
          config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        end

        # FOLLY FIX: Ensure Boost Context symbols are available
        if target.name == 'RCT-Folly'
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= '$(inherited)'
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << ' FOLLY_NO_CONFIG=1'
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << ' FOLLY_MOBILE=1'
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << ' FOLLY_USE_LIBCPP=1'
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << ' FOLLY_HAVE_PTHREAD=1'
        end

      end
    end

    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_project.targets.each do |target|
        if target.name == 'HSOrderSystem'
          target.build_configurations.each do |config|
            # Let the standard linker optimization drop unused Folly symbols (like _jump_fcontext)
          end
        end
      end
      aggregate_target.user_project.save()
    end

    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
  end
end
